{
  "name": "log-note",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "log-note:mcp": "node scripts/log-note-mcp.mjs",
    "mobile:sync": "cap sync",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "studio": "mastra dev --dir src/mastra",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:pwa": "node e2e/run-pwa.mjs",
    "test:e2e": "node e2e/run-mobile.mjs && npm run test:pwa",
    "check": "npm run typecheck && npm run design:check && npm test && npm run test:e2e && git diff --check",
    "design:check": "python3 docs/设计规范/scripts/validate-specs.py"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.69",
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@mastra/core": "1.63.2",
    "@modelcontextprotocol/server": "2.0.0",
    "@supabase/supabase-js": "^2.57.4",
    "next": "15.5.23",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "mastra": "^1.27.2",
    "supabase": "^2.114.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
