# Supabase-compatible browser configuration. Meituan-internal builds use the AIBase Workspace
# URL and publishable/anon value through the approved build control. Never add a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_COMPATIBLE_ENDPOINT
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Distribution selector. Keep standard for the public build; set meituan-sso only in the approved
# Meituan-internal build control. SSO client secrets never belong in this file or the browser bundle.
NEXT_PUBLIC_LOG_NOTE_AUTH_MODE=standard

# Optional public Google OAuth Web client. Leave unset for the Meituan-internal release.
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Optional server-only DeepSeek configuration. Leave unset for the first Meituan-internal release.
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Independent Calendar-to-AI privacy gate. Keep both off unless the production Provider contract
# and settings satisfy the Calendar privacy policy. The browser and server checks must both be on.
NEXT_PUBLIC_CALENDAR_AI_TRANSFER_ENABLED=0
CALENDAR_AI_TRANSFER_ENABLED=0
